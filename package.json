{
  "name": "baybound",
  "version": "0.0.0",
  "private": true,
  "description": "BART general utility & train sync app — Turborepo monorepo",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@baybound/bart-config/prettier",
  "devDependencies": {
    "@baybound/bart-config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.5.0"
  }
}
